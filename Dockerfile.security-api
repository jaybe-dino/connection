# theprlist 운영 API — 보안 키 교체용 재현 패키지 (API 전용)
#
# 목적: Railway에 CLI 업로드 이미지로 떠 있는 현재 운영 API를, git commit 으로
# 추적되는 '동일 소스 + 동일 패키지 버전' 으로 재현한다. 런타임 코드/인증/
# Gmail·OAuth/NICEPAY·TikTok/데이터 암호화(TOKEN_ENC_KEY)는 바꾸지 않는다.
# 운영 비밀값/환경변수는 이미지에 넣지 않는다(런타임 주입).
#
# 소스 해시는 security-runtime-manifest.json 과 일치하며(58파일),
# 패키지 버전은 requirements-security-api*.txt 로 고정한다.
# 시작 명령은 현재 운영과 동일: uvicorn api.main:app --app-dir services/api
# (PORT 환경변수를 존중, 없으면 8000).

FROM python:3.11.17-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# 1) 빌드 베이스 도구 고정(운영 매니페스트 버전)
COPY requirements-security-api.build.txt ./
RUN python -m pip install --no-cache-dir -r requirements-security-api.build.txt

# 2) 서드파티 런타임 의존성 고정 설치(운영 매니페스트의 정확한 버전)
COPY requirements-security-api.txt ./
RUN python -m pip install --no-cache-dir -r requirements-security-api.txt

# 3) 프로젝트 로컬 패키지(core·harvest·api)를 소스에서 설치(--no-deps:
#    의존성은 위에서 이미 고정). 새 의존성/기능 추가 없음.
COPY services/core ./services/core
COPY services/harvest ./services/harvest
COPY services/api ./services/api
RUN python -m pip install --no-cache-dir --no-deps \
      ./services/core ./services/harvest ./services/api

# 4) 건강 점검 — 엄격한 readiness 경로 /health/ready 를 본다. 기존 /health 는
#    DB 오류·startup_error 에도 200 을 주므로 native readiness 로는 부적합하다.
#    /health/ready 는 ok=True & startup_error=None 일 때만 200, 그 외 503.
#    (slim 에 curl 이 없으므로 표준 라이브러리로 확인)
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
  CMD python -c "import os,urllib.request,sys; \
u='http://127.0.0.1:'+os.environ.get('PORT','8000')+'/health/ready'; \
sys.exit(0 if urllib.request.urlopen(u,timeout=4).status==200 else 1)" || exit 1

EXPOSE 8000

# 5) 동일한 운영 app 을 감싼 readiness 래퍼 entrypoint 를 실행 — PORT 존중,
#    같은 API 만 실행(api.main:app 을 import 해 /health/ready 만 추가).
CMD ["sh","-c","exec uvicorn security_api_entrypoint:app --app-dir services/api --host 0.0.0.0 --port ${PORT:-8000}"]
