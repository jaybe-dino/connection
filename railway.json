{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.security-api"
  },
  "deploy": {
    "startCommand": "uvicorn security_api_entrypoint:app --app-dir services/api --host 0.0.0.0 --port ${PORT:-8000}",
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 300,
    "overlapSeconds": 30,
    "drainingSeconds": 30,
    "restartPolicyType": "ON_FAILURE"
  }
}
